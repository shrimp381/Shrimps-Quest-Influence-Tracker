<div class="ql-influence-view">

  <div class="ql-inf-toolbar">
    <div class="ql-inf-menu-wrap">
      <button type="button" data-action="influence-toggle-region-menu" class="ql-icon-btn {{#if influence.showRegionMenu}}ql-active{{/if}}">
        Region: {{influence.region.name}}
      </button>
      {{#if influence.showRegionMenu}}
        <div class="ql-inf-menu">
          {{#each influence.regionOptions}}
            <div class="ql-inf-region-row {{#if this.active}}ql-active{{/if}}">
              {{#if (eq this.id ../influence.editingRegionId)}}
                <div class="ql-inf-region-edit" style="width:100%;">
                  <input type="text" data-action="influence-region-name-draft-change" value="{{../influence.regionNameDraft}}" placeholder="Region name">
                  <div class="ql-form-actions">
                    <button type="button" data-action="influence-cancel-edit-region" class="ql-small-btn ql-ghost">Cancel</button>
                    <button type="button" data-action="influence-confirm-rename-region" data-id="{{this.id}}" class="ql-small-btn">Save</button>
                  </div>
                </div>
              {{else}}
                <button type="button" data-action="influence-select-region" data-id="{{this.id}}" class="ql-inf-region-name-btn">{{this.name}}</button>
                {{#if ../isGm}}
                  <button type="button" data-action="influence-start-edit-region" data-id="{{this.id}}" title="Rename" class="ql-ghost-icon ql-small">&#9998;</button>
                  <button type="button" data-action="influence-delete-region" data-id="{{this.id}}" title="Delete region" class="ql-ghost-icon ql-small">&times;</button>
                {{/if}}
              {{/if}}
            </div>
          {{/each}}
          {{#if isGm}}
            <div class="ql-inf-add-region-row">
              <button type="button" data-action="influence-add-region" class="ql-dashed-btn">+ Add Region</button>
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>

    <div class="ql-inf-sep"></div>

    {{#if isGm}}
      <button type="button" data-action="influence-add-location" class="ql-primary-btn">+ Add Location</button>
      <button type="button" data-action="influence-add-npc" title="Adds to the selected location, or the first location if none is selected" class="ql-ghost-btn">+ Add NPC / Faction</button>
      <button type="button" data-action="influence-add-npc-standalone" title="Places an NPC on the board with no location or faction tie" class="ql-ghost-btn">+ Add Unlinked NPC</button>
      <button type="button" data-action="influence-toggle-link-mode" class="ql-icon-btn {{#if influence.linking}}ql-active{{/if}}">{{#if influence.linking}}Cancel Link{{else}}+ Link Locations{{/if}}</button>
      <button type="button" data-action="influence-toggle-link-npc-mode" class="ql-icon-btn {{#if influence.linkingNpc}}ql-active{{/if}}">{{#if influence.linkingNpc}}Cancel Link{{else}}+ Link NPCs{{/if}}</button>
      <div class="ql-inf-sep"></div>
      <div class="ql-inf-menu-wrap">
        <button type="button" data-action="influence-toggle-bg-menu" class="ql-icon-btn {{#if influence.showBgMenu}}ql-active{{/if}}">Background</button>
        {{#if influence.showBgMenu}}
          <div class="ql-inf-menu ql-inf-bg-menu">
            {{#each influence.bgPresets}}
              <button type="button" data-action="influence-set-region-bg" data-bg="{{this.key}}" title="{{this.label}}" class="ql-inf-bg-swatch {{#if this.active}}ql-active{{/if}}" style="background:{{this.css}}"></button>
            {{/each}}
            <div class="ql-inf-upload-row">
              <button type="button" class="ql-inf-file-btn" data-action="influence-region-bg-upload" title="For the sharpest, least-cropped result, pick an image close to 1600&times;1000px (an 8:5 ratio) &mdash; the board's native size. Other sizes work too; use the Fit slider below to adjust.">
                Upload image&hellip;
              </button>
              {{#if influence.isCustomBg}}
                <div class="ql-inf-fit-row">
                  <label class="ql-hint" style="white-space:nowrap;">Fit</label>
                  <input type="range" min="20" max="300" step="5" value="{{influence.bgScale}}" data-action="influence-bg-fit-change">
                  <span class="ql-inf-fit-readout">{{influence.bgScale}}%</span>
                </div>
              {{/if}}
            </div>
          </div>
        {{/if}}
      </div>
    {{/if}}

    <div class="ql-inf-sep"></div>
    <div class="ql-inf-zoom-group">
      <button type="button" data-action="influence-zoom-out" class="ql-icon-btn">&minus;</button>
      <span class="ql-inf-zoom-readout">{{influence.zoomPct}}%</span>
      <button type="button" data-action="influence-zoom-in" class="ql-icon-btn">+</button>
      <button type="button" data-action="influence-zoom-reset" class="ql-icon-btn">Reset view</button>
    </div>

    <div class="ql-inf-grow"></div>
  </div>

  <div class="ql-inf-workspace">
    <div class="ql-inf-board-wrap {{#if influence.linking}}ql-linking{{/if}}{{#if influence.linkingNpc}}ql-linking{{/if}}" id="ql-inf-board-wrap">
      <div class="ql-inf-board" style="transform: translate({{influence.panX}}px, {{influence.panY}}px) scale({{influence.zoom}});">
        <div class="ql-inf-bg-layer" style="{{influence.backgroundStyle}}"></div>
        <svg class="ql-inf-lines" width="1600" height="1000" viewBox="0 0 1600 1000">
          {{#each influence.lines}}
            <line x1="{{this.x1}}" y1="{{this.y1}}" x2="{{this.x2}}" y2="{{this.y2}}" stroke="{{this.color}}" stroke-width="2" {{#if (eq this.type "neutral")}}stroke-dasharray="6,5"{{/if}}></line>
            <line class="ql-inf-hit" data-action="influence-select-node" data-kind="{{this.kind}}Rel" data-id="{{this.id}}" x1="{{this.x1}}" y1="{{this.y1}}" x2="{{this.x2}}" y2="{{this.y2}}" stroke="transparent" stroke-width="14"></line>
            {{#if this.label}}
              <text class="ql-inf-link-label" x="{{this.midX}}" y="{{this.midY}}" fill="{{this.color}}" text-anchor="middle">{{this.label}}</text>
            {{/if}}
          {{/each}}
          {{#each influence.locations}}
            {{#if this.expanded}}
              {{#each this.npcs}}
                <line class="ql-inf-fan-line" x1="{{this.lineX1}}" y1="{{this.lineY1}}" x2="{{this.lineX2}}" y2="{{this.lineY2}}" stroke="{{this.color}}" stroke-width="1.5" stroke-dasharray="3,3"></line>
              {{/each}}
            {{/if}}
          {{/each}}
        </svg>
        <div>
          {{#each influence.locations}}
            <div class="ql-inf-marker {{#if this.selected}}ql-inf-selected{{/if}} {{#if this.linkTarget}}ql-inf-link-target{{/if}}" data-marker-kind="location" data-marker-id="{{this.id}}" data-action="influence-select-node" data-kind="location" data-id="{{this.id}}" style="left:{{this.x}}px; top:{{this.y}}px;">
              <div class="ql-inf-token" style="{{this.styleVar}}{{this.imageStyle}}">
                {{#unless this.image}}<span class="ql-inf-initial">{{this.initial}}</span>{{/unless}}
                {{#if ../isGm}}
                  <button type="button" class="ql-inf-expand-flag" data-action="influence-toggle-expand" data-id="{{this.id}}" title="{{#if this.expanded}}Collapse{{else}}Expand{{/if}} linked NPCs">{{#if this.expanded}}&minus;{{else}}+{{/if}}</button>
                {{/if}}
              </div>
              <span class="ql-inf-marker-label">{{this.name}}</span>
              <div class="ql-inf-marker-sub"><span class="ql-inf-stat-pill">{{this.linkedCount}} linked</span></div>
            </div>
            {{#if this.expanded}}
              {{#each this.npcs}}
                <div class="ql-inf-marker ql-inf-token-npc {{#if this.selected}}ql-inf-selected{{/if}} {{#if this.linkTarget}}ql-inf-link-target{{/if}}" data-marker-kind="npc" data-marker-id="{{this.id}}" data-marker-locked="1" data-action="influence-select-node" data-kind="npc" data-id="{{this.id}}" style="left:{{this.x}}px; top:{{this.y}}px;">
                  <div class="ql-inf-token" style="{{this.styleVar}}{{this.imageStyle}}">
                    {{#unless this.image}}<span class="ql-inf-initial">{{this.initial}}</span>{{/unless}}
                  </div>
                  <span class="ql-inf-marker-label">{{this.name}}</span>
                  {{#if this.hasStats}}
                    <div class="ql-inf-marker-sub">
                      {{#if this.showStanding}}<span class="ql-inf-stat-pill {{this.standingClass}}">S {{this.standingLabel}}</span>{{/if}}
                      {{#if this.showFavour}}<span class="ql-inf-stat-pill {{this.favourClass}}">F {{this.favourLabel}}</span>{{/if}}
                      {{#if this.showRelationship}}<span class="ql-inf-stat-pill {{this.relationshipClass}}">R {{this.relationshipLabel}}</span>{{/if}}
                    </div>
                  {{/if}}
                </div>
              {{/each}}
            {{/if}}
          {{/each}}

          {{#each influence.standaloneNpcs}}
            <div class="ql-inf-marker ql-inf-token-npc ql-inf-standalone {{#if this.selected}}ql-inf-selected{{/if}} {{#if this.linkTarget}}ql-inf-link-target{{/if}}" data-marker-kind="npc" data-marker-id="{{this.id}}" data-action="influence-select-node" data-kind="npc" data-id="{{this.id}}" style="left:{{this.x}}px; top:{{this.y}}px;">
              <div class="ql-inf-token" style="{{this.styleVar}}{{this.imageStyle}}">
                {{#unless this.image}}<span class="ql-inf-initial">{{this.initial}}</span>{{/unless}}
              </div>
              <span class="ql-inf-marker-label">{{this.name}}</span>
              {{#if this.hasStats}}
                <div class="ql-inf-marker-sub">
                  {{#if this.showStanding}}<span class="ql-inf-stat-pill {{this.standingClass}}">S {{this.standingLabel}}</span>{{/if}}
                  {{#if this.showFavour}}<span class="ql-inf-stat-pill {{this.favourClass}}">F {{this.favourLabel}}</span>{{/if}}
                  {{#if this.showRelationship}}<span class="ql-inf-stat-pill {{this.relationshipClass}}">R {{this.relationshipLabel}}</span>{{/if}}
                </div>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </div>
      {{#if influence.linking}}<div class="ql-inf-linking-toast">Click two locations to link them</div>{{/if}}
      {{#if influence.linkingNpc}}<div class="ql-inf-linking-toast">Click two NPCs to link them</div>{{/if}}
    </div>

    <div class="ql-inf-inspector {{#unless influence.hasInspector}}ql-inf-empty{{/unless}}">
      {{#if influence.hasInspector}}
        {{#with influence.inspector}}
          <div class="ql-inf-insp-head">
            {{#unless this.isRelationship}}
              <div class="ql-inf-token-mini" style="{{this.styleVar}}{{this.imageStyle}}">{{#unless this.image}}{{this.initial}}{{/unless}}</div>
            {{/unless}}
            <span class="ql-inf-kind">{{this.kindLabel}}</span>
            <button type="button" data-action="influence-close-inspector" class="ql-inf-insp-x">&times;</button>
          </div>

          {{#if this.isRelationship}}
            <div class="ql-inf-field"><label>Between</label><span>{{this.aName}} &harr; {{this.bName}}</span></div>
            {{#if ../isGm}}
              <div class="ql-inf-link-type-row">
                <button type="button" data-action="influence-set-rel-type" data-kind="{{this.relKind}}" data-id="{{this.id}}" data-type="alliance" class="ql-inf-link-type-btn {{#if (eq this.type "alliance")}}ql-active{{/if}}">Alliance</button>
                <button type="button" data-action="influence-set-rel-type" data-kind="{{this.relKind}}" data-id="{{this.id}}" data-type="neutral" class="ql-inf-link-type-btn {{#if (eq this.type "neutral")}}ql-active{{/if}}">Neutral</button>
                <button type="button" data-action="influence-set-rel-type" data-kind="{{this.relKind}}" data-id="{{this.id}}" data-type="hostile" class="ql-inf-link-type-btn {{#if (eq this.type "hostile")}}ql-active{{/if}}">Hostile</button>
              </div>
              <div class="ql-inf-field">
                <label>Label</label>
                <input type="text" data-action="influence-rel-label-change" data-kind="{{this.relKind}}" data-id="{{this.id}}" value="{{this.label}}" placeholder="e.g. Trade pact">
              </div>
              <button type="button" data-action="influence-delete-relationship" data-kind="{{this.relKind}}" data-id="{{this.id}}" class="ql-delete-btn">Delete link</button>
            {{else}}
              <span class="ql-inf-hint">{{this.label}}</span>
            {{/if}}
          {{else}}
            {{#if ../isGm}}
              <div class="ql-inf-field">
                <label>Name</label>
                <input type="text" data-action="influence-node-name-change" data-kind="{{this.kind}}" data-id="{{this.id}}" value="{{this.name}}">
              </div>
              <div class="ql-inf-field">
                <label>Colour</label>
                <div class="ql-inf-swatch-row">
                  {{#each this.swatches}}
                    <button type="button" data-action="influence-set-node-color" data-kind="{{../kind}}" data-id="{{../id}}" data-color="{{this}}" class="ql-inf-swatch {{#if (eq this ../color)}}ql-active{{/if}}" style="background:{{this}};"></button>
                  {{/each}}
                </div>
              </div>
              <div class="ql-inf-field">
                <label>Image (optional)</label>
                <button type="button" class="ql-inf-file-btn" data-action="influence-node-image-upload" data-kind="{{this.kind}}" data-id="{{this.id}}">
                  {{#if this.image}}Replace image{{else}}Upload image{{/if}}
                </button>
              </div>
              <div class="ql-inf-field">
                <label>Notes</label>
                <textarea data-action="influence-node-notes-change" data-kind="{{this.kind}}" data-id="{{this.id}}">{{this.notes}}</textarea>
              </div>

              {{#if this.isNpc}}
                <div class="ql-inf-stat-row">
                  <span class="ql-inf-stat-name">Standing</span>
                  <div class="ql-inf-stepper">
                    <button type="button" data-action="influence-npc-stat-dec" data-id="{{this.id}}" data-stat="standing">&minus;</button>
                    <span class="ql-inf-val {{this.standingClass}}">{{this.standingLabel}}</span>
                    <button type="button" data-action="influence-npc-stat-inc" data-id="{{this.id}}" data-stat="standing">+</button>
                  </div>
                </div>
                <div class="ql-inf-stat-row">
                  <span class="ql-inf-stat-name">Favour</span>
                  <div class="ql-inf-stepper">
                    <button type="button" data-action="influence-npc-stat-dec" data-id="{{this.id}}" data-stat="favour">&minus;</button>
                    <span class="ql-inf-val {{this.favourClass}}">{{this.favourLabel}}</span>
                    <button type="button" data-action="influence-npc-stat-inc" data-id="{{this.id}}" data-stat="favour">+</button>
                  </div>
                </div>
                <div class="ql-inf-stat-row">
                  <span class="ql-inf-stat-name">Relationship</span>
                  <div class="ql-inf-stepper">
                    <button type="button" data-action="influence-npc-stat-dec" data-id="{{this.id}}" data-stat="relationship">&minus;</button>
                    <span class="ql-inf-val {{this.relationshipClass}}">{{this.relationshipLabel}}</span>
                    <button type="button" data-action="influence-npc-stat-inc" data-id="{{this.id}}" data-stat="relationship">+</button>
                  </div>
                </div>
                <div class="ql-inf-stat-toggle-row">
                  <label><input type="checkbox" data-action="influence-toggle-npc-stat" data-id="{{this.id}}" data-stat="standing" {{#if this.showStanding}}checked{{/if}}> Show S</label>
                  <label><input type="checkbox" data-action="influence-toggle-npc-stat" data-id="{{this.id}}" data-stat="favour" {{#if this.showFavour}}checked{{/if}}> Show F</label>
                  <label><input type="checkbox" data-action="influence-toggle-npc-stat" data-id="{{this.id}}" data-stat="relationship" {{#if this.showRelationship}}checked{{/if}}> Show R</label>
                </div>
              {{/if}}

              {{#if this.isLocation}}
                <div class="ql-inf-field">
                  <label>NPCs / Factions here</label>
                  <div class="ql-inf-child-list">
                    {{#each this.children}}
                      <div class="ql-inf-child-row" data-action="influence-select-node" data-kind="npc" data-id="{{this.id}}">
                        <span class="ql-inf-dot" style="background:{{this.color}};"></span>
                        <span class="ql-inf-name">{{this.name}}</span>
                      </div>
                    {{else}}
                      <span class="ql-inf-hint">None yet.</span>
                    {{/each}}
                  </div>
                </div>
              {{/if}}

              <button type="button" data-action="influence-show-players" data-kind="{{this.kind}}" data-id="{{this.id}}" title="Spotlight this {{this.kindLabel}} in every connected player's Quest Log" class="ghost-btn">&#128227; Show Players</button>
              <button type="button" data-action="influence-delete-node" data-kind="{{this.kind}}" data-id="{{this.id}}" class="ql-delete-btn ql-large">Delete {{this.kindLabel}}</button>
            {{else}}
              <div class="ql-inf-field"><label>Name</label><span>{{this.name}}</span></div>
              {{#if this.notes}}<p class="ql-summary-text">{{this.notes}}</p>{{/if}}
              <span class="ql-inf-hint">Only the GM can edit the Influence board. You're viewing it read-only.</span>
            {{/if}}
          {{/if}}
        {{/with}}
      {{else}}
        <span>Select a location, NPC or relationship line to see its details here.</span>
      {{/if}}
    </div>
  </div>
</div>
