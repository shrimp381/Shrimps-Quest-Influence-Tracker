{{!-- Single row inside #poi-list. Rendered by {{#each pois}}{{> dh-poi-row}}{{/each}}
      in window.hbs. Context: one entry from DistantHorizonsApp#_poiRowContext(). --}}
<tr class="poi-row{{#if locked}} locked{{/if}}" data-poi-id="{{id}}">
  <td>
    <input type="text" class="poi-name-input" data-action="renamePoi" data-poi-id="{{id}}" value="{{name}}">
  </td>
  <td>
    <div class="poi-icon-field">
      {{#if hasCustomIcon}}
        <span class="img-chip" title="{{customIconTitle}}">&#x1F5BC; custom</span>
        <button type="button" class="icon-btn small clear-icon-btn" data-action="clearPoiIcon" data-poi-id="{{id}}" title="{{clearIconTitle}}">{{{iconClear}}}</button>
      {{else}}
        <select class="poi-icon-select" data-action="changePoiIcon" data-poi-id="{{id}}">{{{iconOptionsHtml}}}</select>
      {{/if}}
      <button type="button" class="icon-btn small upload-icon-btn" data-action="triggerPoiIconUpload" data-poi-id="{{id}}" title="{{uploadIconTitle}}">{{{iconUpload}}}</button>
    </div>
  </td>
  <td>
    <select class="poi-layer-select" data-action="changePoiLayer" data-poi-id="{{id}}">{{{layerOptionsHtml}}}</select>
  </td>
  <td>
    <select class="size-sel" data-action="changePoiSize" data-poi-id="{{id}}" title="{{sizeTitle}}">{{{sizeOptionsHtml}}}</select>
  </td>
  <td>
    <select class="poi-state-select" data-poi-id="{{id}}">{{{stateOptionsHtml}}}</select>
  </td>
  <td class="actions-cell">
    <button type="button" class="icon-btn" data-action="focusPoi" data-poi-id="{{id}}" title="{{focusTitle}}">{{{iconEye}}}</button>
    <button type="button" class="icon-btn{{#if locked}} lock-on{{/if}}" data-action="togglePoiLock" data-poi-id="{{id}}" title="{{lockTitle}}">{{{lockIcon}}}</button>
    <button type="button" class="icon-btn danger" data-action="deletePoi" data-poi-id="{{id}}" title="{{deleteTitle}}">{{{iconTrash}}}</button>
  </td>
</tr>
